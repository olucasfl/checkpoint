// Schema do Prisma. Toda alteracao aqui termina em `npm run db:migrate`, que gera uma migration
// versionada em prisma/migrations/ (commitada).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Codigos sem espaco e sem acento; o texto de tela ("Quero jogar") vive so no web.
enum GameStatus {
  ZERADO
  JOGANDO
  QUERO_JOGAR
}

model Game {
  id               String     @id @default(uuid())
  // Gravados ja aparados (trim) pelo GamesService.
  titulo           String     @db.VarChar(120)
  // "" significa "sem plataforma" (a API expoe null). Guardar "" em vez de NULL faz o par de
  // unicidade abaixo tratar jogo sem plataforma como uma plataforma "vazia": no Postgres,
  // NULL nunca conflita com NULL.
  plataforma       String     @default("") @db.VarChar(60)
  status           GameStatus
  // Notas por criterio (spec avaliacao-de-jogos), em DECIMOS: 0 a 100 no banco, 0 a 10 na API (73 = 7,3).
  // Inteiros evitam Decimal e ponto flutuante; a conversao fica so no GamesService. A nota geral nao e
  // gravada: e a media calculada por notaMedia() do shared. CHECKs (faixa e Quero jogar sem nota) na migration.
  notaGameplay     Int?
  notaHistoria     Int?
  notaGraficos     Int?
  notaTrilhaSonora Int?
  notaPerformance  Int?

  // Texto simples (sem Markdown nem HTML), aparado; vazio vira NULL no service.
  descricao String? @db.VarChar(1000)

  // Chaves de comparacao da unicidade (titulo/plataforma em minusculas), preenchidas pelo
  // GamesService a partir do estado final. Colunas normalizadas em vez de um indice com lower()
  // escrito a mao: o Prisma nao modela indice por expressao e o `migrate dev` acusaria drift.
  tituloNormalizado     String @db.VarChar(120)
  plataformaNormalizada String @default("") @db.VarChar(60)

  // Caminho do objeto no bucket de capas ("<userId>/<gameId>/<uuid>.<ext>"; as enviadas antes da
  // etapa 3 de autenticacao ficam em "<gameId>/<uuid>.<ext>"), nao a URL: a capaUrl e montada na
  // resposta a partir de SUPABASE_URL e do bucket, entao trocar de projeto nao exige migrar dados.
  capaPath String? @db.VarChar(120)

  // Dono do jogo (spec autenticacao). Excluir a conta apaga os jogos dela; as capas no bucket ficam
  // por conta de quem exclui.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Camada de dados vinda de uma plataforma (spec integracao-plataformas); no maximo uma por provedor.
  dadosPlataforma JogoPlataforma[]

  // Unicidade por dono. Com userId na frente, tambem serve de indice para `where: { userId }`.
  @@unique([userId, tituloNormalizado, plataformaNormalizada])
  @@index([status])
}

// Conta de acesso (spec autenticacao).
model User {
  id        String @id @default(uuid())
  nome      String @db.VarChar(60)
  // Sempre gravado normalizado (trim + minusculas). E so identificador de login: NAO e verificado.
  email     String @unique @db.VarChar(254)
  // Hash no formato autodescritivo do algoritmo (`scrypt$N$r$p$sal$hash`), nunca a senha.
  senhaHash String @db.VarChar(255)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessoes          RefreshSession[]
  games            Game[]
  contasVinculadas ContaVinculada[]
  jogosPlataforma  JogoPlataforma[]
}

// Plataformas de jogos que a API sabe integrar (spec integracao-plataformas). Codigos sem acento; o texto
// de tela vive so no web. Acrescentar um valor depois e `ALTER TYPE ... ADD VALUE`, tambem aditivo.
enum Provedor {
  STEAM
}

// A conta do usuario numa plataforma, com a posse ja comprovada (na Steam, pelo OpenID). Uma por provedor.
// Desvincular apaga esta linha e todos os JogoPlataforma do provedor (feito no service, numa transacao).
model ContaVinculada {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provedor     Provedor
  // Na Steam, o SteamID64. Ja comprovado pelo provedor: o usuario nunca o digita.
  idExterno    String   @db.VarChar(40)
  nomeExibicao String   @db.VarChar(80)
  vinculadaEm  DateTime @default(now())

  @@unique([userId, provedor])
  @@unique([userId, provedor, idExterno])
}

// A camada da plataforma sobre um jogo do catalogo: o ULTIMO valor consultado, nunca substitui titulo,
// status, notas ou capa do usuario. 1 para 1 nos dois sentidos. A lista de conquistas NAO e gravada
// (e buscada ao abrir o detalhe). CHECKs (minutos >= 0 e desbloqueadas <= total) na migration.
model JogoPlataforma {
  id                      String    @id @default(uuid())
  // Repetido de Game.userId para a unicidade por usuario; o service sempre grava com where: { id, userId }.
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId                  String
  game                    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  provedor                Provedor
  // Na Steam, o appid.
  idExterno               String    @db.VarChar(40)
  minutosJogados          Int
  ultimaVezJogadoEm       DateTime?
  // null = nunca consultado ou negado (privado); 0 = o jogo nao tem conquistas.
  conquistasTotal         Int?
  conquistasDesbloqueadas Int?
  capaUrl                 String?   @db.VarChar(300)
  atualizadoEm            DateTime

  @@unique([userId, provedor, idExterno])
  @@unique([gameId, provedor])
}

// Uma linha por dispositivo logado. O `id` e o `sid` dos tokens.
model RefreshSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // sha256 (hex) do refresh atual: o token tem alta entropia, entao um hash rapido basta, e o bcrypt
  // truncaria em 72 bytes e colidiria tokens do mesmo usuario.
  tokenHash     String    @db.Char(64)
  // Do refresh anterior: janela de graca (corrida de abas) e deteccao de reuso.
  hashAnterior  String?   @db.Char(64)
  rotacionadoEm DateTime?

  // Rotulo legivel derivado do User-Agent ("Chrome · Android"); sem IP e sem localizacao.
  dispositivo String   @db.VarChar(80)
  criadoEm    DateTime @default(now())
  ultimoUsoEm DateTime @default(now())
  expiraEm    DateTime

  @@index([userId])
}
