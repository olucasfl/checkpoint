# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta em que a API sobe
PORT=3333

# Origens permitidas no CORS, separadas por virgula. OBRIGATORIA e sem * (com cookie de sessao, refletir
# qualquer origem deixaria qualquer site renovar a sessao): a API nao sobe com *.
CORS_ORIGIN=http://localhost:5173

# Conexao com o PostgreSQL usada em runtime pela app.
# Se for Supabase: use o Connection Pooler em modo "Transaction" (porta 6543) e acrescente
# ?pgbouncer=true&connection_limit=1 no final da URL.
DATABASE_URL=postgresql://user:password@host:5432/database

# Conexao usada só pelo Prisma Migrate. Precisa suportar locks de sessão -
# se for Supabase, use o Connection Pooler em modo "Session" (mesma host, porta 5432, sem
# pgbouncer=true). O host direto (db.<ref>.supabase.co) é IPv6-only e pode não ser alcançável
# em algumas redes.
DIRECT_URL=postgresql://user:password@host:5432/database

# Supabase Storage (capas dos jogos). So o backend usa estas variaveis; NUNCA ponha nada disso no web.
# URL do projeto Supabase (o mesmo do banco).
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key do projeto (sb_secret_...), em Settings > API Keys > Secret keys. Ignora RLS e da acesso
# de escrita ao Storage: nunca commitar, nunca logar. A chave publishable (sb_publishable_...) e
# recusada no boot. O nome da variavel e mantido por compatibilidade.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket publico das capas (leitura publica, escrita so pelo backend).
SUPABASE_STORAGE_BUCKET=capas

# Autenticacao (spec autenticacao). Gere cada segredo localmente, UM DIFERENTE PARA CADA (>= 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca commitar, nunca colar em log, spec ou PR.
# Assina o access token (15 min).
JWT_ACCESS_SECRET=
# Assina o refresh token (30 dias, no cookie HttpOnly). Precisa ser diferente do JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=
# Registro de contas novas: true (aberto) ou false (fechado). Comece com true; depois de criar a sua
# conta, mude para false.
AUTH_REGISTRATION_OPEN=true
# OPCIONAL, so para dev/teste (verificacao manual que cria varias contas). Ausente = 3 registros por hora
# por IP. Em ambiente exposto, deixe ausente.
# AUTH_REGISTRATION_LIMIT_PER_HOUR=

# Integracao com plataformas de jogos (spec integracao-plataformas). OBRIGATORIAS: a API nao sobe sem elas.
# Em producao, cadastre as tres no Render ANTES do deploy.
# Chave da Steam Web API (32 hexadecimais), em https://steamcommunity.com/dev/apikey (pede um "dominio":
# use o da Vercel). So o backend a usa; nunca no web, em log, teste, fixture ou commit.
STEAM_API_KEY=
# Endereco em que o NAVEGADOR alcanca a API (return_to e realm do OpenID da Steam), sem barra final.
# Producao: o dominio da Vercel (o /api passa pelo rewrite ate o Render), NAO o do Render.
API_PUBLIC_URL=http://localhost:3333
# Origem do web, para onde o retorno do vinculo redireciona, sem barra final. Producao: o dominio da Vercel.
WEB_PUBLIC_URL=http://localhost:5173
