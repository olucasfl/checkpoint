# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta em que a API sobe
PORT=3333

# Origens permitidas no CORS (separadas por virgula, ou * para liberar todas)
CORS_ORIGIN=http://localhost:5173

# Conexao com o PostgreSQL (precisa bater com o docker-compose.yml da raiz)
DATABASE_URL=postgresql://checkpoint:checkpoint@localhost:5432/checkpoint?schema=public
